# 服务端口
PORT=8880

# 数据库连接（MySQL 8.x）
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=moredoc
# 表前缀，与原版一致，默认 mnt_
DB_PREFIX=mnt_

# JWT
# 生产环境（NODE_ENV=production）必须配置足够强的随机密钥，使用默认值 moredoc 将拒绝启动。
# 生成方式示例：openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE_DAYS=3650

# 上传文件存储目录（相对运行目录）
UPLOAD_DIR=uploads
DOCUMENT_DIR=documents

# 允许跨域来源，使用逗号分隔；留空表示允许所有来源（将自动禁用 Cookie 凭据）
CORS_ORIGIN=

# 部署在 CDN/Nginx 反向代理之后时置为 true，使限流与 IP 记录取到真实客户端 IP
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# 统一身份 SSO（user-center 为 IdP，lib 为接入方）
# 需要在数据库 config 表中配置 oauthCustom 分类：
#   token_url      = https://apiuser.shanhe.co/api/oauth/token （或 https://apiuser.shanhe.co/oauth/token）
#   userinfo_url   = https://apiuser.shanhe.co/api/oauth/userinfo
#   authorize_url  = https://user.shanhe.co/oauth/authorize
#   client_id      = shanhe_lib_client（user-center 启动时自动 seed）
#   client_secret  = 对应 confidential client 的明文密钥
#   scope          = openid profile email phone
#   enable         = true
# jwks_uri 可省略，后端自动从 token_url 推导出 /oauth/jwks。
# user-center 侧需开启 CORS_ALLOW_SHANHE_SUBDOMAINS=true 放行 *.shanhe.co，
# 且上述 client 需为 confidential 并授予 refresh_token / password grant。
# ---------------------------------------------------------------------------