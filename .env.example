# 服务端口
PORT=8880

# 数据库连接（MySQL 8.x）
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=moredoc
# 表前缀，与原版一致，默认 mnt_
DB_PREFIX=mnt_

# JWT
JWT_SECRET=moredoc
JWT_EXPIRE_DAYS=3650

# 上传文件存储目录（相对运行目录）
UPLOAD_DIR=uploads
DOCUMENT_DIR=documents

# 允许跨域来源，使用逗号分隔；留空表示允许所有
CORS_ORIGIN=